<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- JDK 8 + Spring Boot 2.7.18：稳妥版本线，javax.* 兼容银行/发票/CA 老 SDK -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>com.lukachangtong</groupId>
  <artifactId>freight-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>freight-platform</name>
  <description>鹭卡畅通网络货运平台 - JDK 8 + Spring Boot 2.7.18 模块化单体</description>

  <!-- M1 先建 6 个模块；freight-dependencies 独立 BOM 待模块数增多后再拆出，
       避免 Maven reactor 内 import BOM 的历史兼容问题。版本统一由本 pom 锁定。 -->
  <modules>
    <module>freight-common</module>
    <module>freight-api</module>
    <module>freight-infra</module>
    <module>freight-auth</module>
    <module>freight-basedata</module>
    <module>freight-carrier</module>
    <module>freight-waybill</module>
    <module>freight-contract</module>
    <module>freight-track</module>
    <module>freight-message</module>
    <module>freight-payment</module>
    <module>freight-settlement</module>
    <module>freight-customer</module>
    <module>freight-stat</module>
    <module>freight-report</module>
    <module>freight-app</module>
  </modules>

  <properties>
    <java.version>8</java.version>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- 构建机是 JDK 8 时禁止配置 release 标签：javac 的 release 选项自 JDK 9 起才提供 -->
    <mybatis-plus.version>3.5.5</mybatis-plus.version>
    <mysql.version>8.0.33</mysql.version>
    <!-- Spring Boot 2.7.18 自带 Flyway 8.5.13 不识别 MySQL 8.0.31+（报 Unsupported Database: MySQL 8.0）；
         升级到 9.x 以支持本机 MySQL 8.0.46，且仍兼容 JDK 8 与 Boot 2.7 的 FlywayAutoConfiguration。 -->
    <flyway.version>9.22.3</flyway.version>
    <redisson.version>3.23.5</redisson.version>
    <xxl-job.version>2.4.0</xxl-job.version>
    <jjwt.version>0.11.5</jjwt.version>
    <archunit.version>1.2.1</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-infra</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-auth</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-basedata</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-carrier</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-waybill</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-contract</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-track</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-message</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-payment</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-settlement</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-customer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-stat</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lukachangtong</groupId>
        <artifactId>freight-report</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-boot-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mysql</groupId>
        <artifactId>mysql-connector-j</artifactId>
        <version>${mysql.version}</version>
      </dependency>
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson-spring-boot-starter</artifactId>
        <version>${redisson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.xuxueli</groupId>
        <artifactId>xxl-job-core</artifactId>
        <version>${xxl-job.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <source>8</source>
            <target>8</target>
            <encoding>UTF-8</encoding>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
